<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Replaces vanilla's HelpGatheringItemsForCaravan, which a Harmony prefix stands down while the Load
    setting is on. The vanilla def is left where it is, so other mods' patches to it still apply.
    canBeDoneByMechs is left at its default, true: a Lifter hauls, and 1.6/Patches/MechWorkTypes.xml
    gives it the Load work type.
  -->
  <WorkGiverDef>
    <defName>CCE_LoadCaravan</defName>
    <label>load caravans</label>
    <giverClass>CaravansCriticallyEnhanced.Jobs.WorkGiver_CCE_LoadCaravan</giverClass>
    <workType>CCE_Loading</workType>
    <verb>load</verb>
    <gerund>loading</gerund>
    <priorityInType>110</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!--
    Leads a forming caravan's pen animals to its gathering spot. Ahead of loading in the Load column,
    because the caravan gathers its animals before its items. Only colonists rope animals in vanilla,
    so mechs are kept off it here as well as in the giver's ShouldSkip. The verb, gerund and
    capacities are vanilla TakeToPen's, so the right-click option reads as vanilla's roping does.
    TakeToPen's prioritizeSustains is left out: JobGiver_Work acts on it only for a giver whose thing
    request accepts the prioritised thing, and this giver has no thing request.
  -->
  <WorkGiverDef>
    <defName>CCE_RopeAnimalsToCaravan</defName>
    <label>rope animals for caravans</label>
    <giverClass>CaravansCriticallyEnhanced.Jobs.WorkGiver_CCE_RopeCaravanAnimals</giverClass>
    <workType>CCE_Loading</workType>
    <verb>rope</verb>
    <gerund>roping</gerund>
    <priorityInType>120</priorityInType>
    <canBeDoneByMechs>false</canBeDoneByMechs>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

</Defs>
